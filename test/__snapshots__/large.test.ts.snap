        '200':
          content:
            application/json:
              example:
                article:
                  author:
                    blocked: false
                    created_at: '2017-01-19 16:34:39'
                    description: null
                    id: 11
                    name: Sven
                    name_possessive: Svens
                    preferences:
                      public_profile: true
                      subscription_enable_identification: true
                    public_profile: false
                    reputation: 0
                    reputation_pretty: '***'
                    team: true
                    updated_at: '2024-08-30 04:00:05'
                    url_slug: 11-Sven
                    username: Sven
                  categories:
                    - description: null
                      id: 34
                      slug: allgemein
                      title: Allgemein
                      url_slug: 34-allgemein
                  comments_count: 10
                  featured: false
                  id: 8582
                  intro: Mit diesen Tipps macht ihr uns das Leben leichter
                  preferences:
                    clips: true
                    comments: true
                    likes: true
                    shares: true
                    tags: true
                  publish_date: '2024-04-10 14:25:00'
                  slug: so-erhoht-ihr-die-chance-dass-wir-eure-spielshows-spielen
                  text: >-
                    <p>Erst vor kurzem haben wir <a
                    href="http://ptsmt.de/n/8581">einen Artikel
                    veröffentlicht</a>, mit dem ihr eure Chance erhöht, dass wir
                    eure Einsendungen für &quot;<strong>50 Fragen
                    zu..</strong>.&quot; spielen. Aber natürlich haben wir noch
                    viele andere Formate, die bei euch hoch im Kurs stehen und
                    für die ihr regelmäßig neue <strong>Shows</strong>
                    anfertigt. Die Mail für eure Einsendungen ist übrigens
                    spielshow[at]pietsmiet.de.</p>

                    <p>Um zum Thema zurückzukommen: Viele Punkte aus dem <a
                    href="http://ptsmt.de/n/8581">Artikel zu &quot;50 Fragen
                    zu...&quot;</a> gelten auch für andere
                    <strong>Spielshows</strong>. Wir checken natürlich alles
                    nochmal durch und passen bei Bedarf Fragen oder Aufgaben
                    an.  In kurz: </p>

                    <ul>

                    <li>Interessant genug für die Allgemeinheit</li>

                    <li>Interessant genug für PietSmiet</li>

                    <li>Basiswissen muss vorhanden sein (schwierig, wissen
                    wir)</li>

                    <li>Machbarer Schwierigkeitsgrad</li>

                    <li>Nachvollziehbare Quellen</li>

                    <li>Passende Dateiformate (Audios als MP3., Bilder als Jpg
                    oder Png)</li>

                    <li>Textbasierte Einsendungen gerne als Word, Excel oder
                    Google Docs</li>

                    </ul>

                    <h3>Einzelne Dateien mitschicken!</h3>

                    <p>Packt bei euren Einsendungen bitte die <strong>Dateien in
                    die Mail</strong>, die ihr für das Format benutzt habt. Dazu
                    gehören beispielsweise <strong>Bilder</strong>,
                    <strong>Audiodateien</strong> etc., damit wir die im Schnitt
                    auch alle auf unsere Bedürfnisse anpassen können. Ein
                    400x400 Screenshot in einem Word-Dokument ist vielleicht gut
                    gemeint, nützt uns im Cut aber nur bedingt etwas. Unsere
                    fleißigen Cutter und Cutterinnen würden gerne jegliche
                    Stellschrauben separat anpassen können und benötigen dafür
                    natürlich all die Dateien, die ihr auch benutzt habt. Euer
                    Vorteil: Ihr müsst keine riesigen Videos bspw. zum
                    <strong>Nerdquiz</strong> selber schneiden oder in
                    <strong>PowerPoint</strong> aufwendige Präsentationen
                    basteln, die finale Optik übernehmen wir. </p>

                    <p>Auch an dieser Stelle nochmal <strong>danke</strong> an
                    all die Personen, die in der Vergangenheit Einsendungen
                    erstellt haben oder in Zukunft noch Bock darauf haben. Wir
                    wissen, das ist nicht selbstverständlich und wir freuen uns
                    immer, wenn ihr mit coolen Ideen um die Ecke kommt. Gerne
                    per Mail oder auch bei den <strong>Vorschlägen</strong> hier
                    auf der <strong>Website</strong>!</p>
                  thumbnail:
                    collection: thumbnail
